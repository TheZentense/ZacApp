{
  "expo": {
    "name": "ZacApp",
    "slug": "zacapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "zacapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gt.edu.zacapp"
    },
    "android": {
      "package": "gt.edu.zacapp",
      "adaptiveIcon": {
        "backgroundColor": "#F2F7EE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que ZacApp acceda a la cámara para adjuntar evidencia a los reportes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
