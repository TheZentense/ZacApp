{
  "expo": {
    "name": "ZacApp",
    "slug": "zacapp",
    "version": "0.3.0",
    "icon": "./assets/images/zacapp-logo-dark.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "zacapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gt.edu.zacapp"
    },
    "android": {
      "package": "gt.edu.zacapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/zacapp-logo-dark.png",
        "backgroundColor": "#F2F7EE"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que ZacApp acceda a la cámara para adjuntar evidencia a los reportes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que ZacApp seleccione fotografías para adjuntar evidencia a los reportes.",
          "cameraPermission": "Permitir que ZacApp acceda a la cámara para adjuntar evidencia a los reportes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que ZacApp acceda a tu ubicación para registrar el punto exacto del incidente."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e070ecfe-f978-42fd-855b-328505ec8ddf"
      }
    },
    "owner": "zentense",
    "updates": {
      "url": "https://u.expo.dev/e070ecfe-f978-42fd-855b-328505ec8ddf",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
