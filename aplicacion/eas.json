{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "biometric-test": {
      "extends": "preview",
      "autoIncrement": true,
      "environment": "preview",
      "channel": "biometric-test",
      "env": {
        "ZACAPP_BUILD_VARIANT": "biometric-test",
        "EXPO_PUBLIC_GUEST_REPORT_TURNSTILE_ENFORCED": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  }
}
